# ========= 喷涂质检 Agent V1.0 环境变量模板 =========
# 复制为 .env 后填写真实值：cp .env.example .env
# 密钥一律写在本文件（.env），严禁提交到代码库或写入系统环境变量。

# ---- LLM ----
# qwen  = 通义千问 DashScope（需填 DASHSCOPE_API_KEY）
# mock  = 离线演示用 Mock 模型（无需密钥，全链路可跑通）
LLM_PROVIDER=mock
QWEN_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
# 公网 DashScope key 或专属端点(*.maas.aliyuncs.com) key；QWEN_BASE_URL 必须与之匹配
QWEN_API_KEY=sk-请替换为你的通义千问APIKey
# 公网 compatible-mode（默认）；专属端点示例：https://xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- Provider 切换（Mock ↔ 真实组件，节点代码零修改） ----
# CV: mock | yolo_http   RAG: mock | redis_vector
CV_PROVIDER=mock
RAG_PROVIDER=mock

# ---- 存储 ----
PG_DSN=postgresql+asyncpg://spray:spray_qc_2026@localhost:5432/spray_qc
# 注: RediSearch 仅支持 DB0 建索引 -> 向量库与会话状态同库, 靠 key 前缀隔离
REDIS_VECTOR_DSN=redis://localhost:6379/0
REDIS_STATE_DSN=redis://localhost:6379/0
REDIS_STATE_TTL_SEC=86400
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_IMAGE_BUCKET=inspection-images
MINIO_REPORT_BUCKET=reports

# ---- 安全 ----
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MIN=720

# ---- 服务 ----
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
